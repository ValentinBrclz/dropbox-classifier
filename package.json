{
  "name": "dropbox-classifier",
  "version": "1.0.0",
  "private": true,
  "description": "Dropbox -> Gemini classification pipeline on Cloudflare (D1, Queues, Workflows).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "generate-types": "wrangler types",
    "check-types": "wrangler types --check",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "npm run typecheck && node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "migrate:local": "wrangler d1 migrations apply epost-ledger --local"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
