# Copy to .dev.vars for local `wrangler dev`. Do NOT commit .dev.vars.
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""
GEMINI_API_KEY=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Folder layout and recipient are secrets too (kept out of the repository).
# Paths are in the namespace of the Dropbox token (non-recursive watch).
DROPBOX_SOURCE="/Apps/IncomingScans"
ARCHIVE_FOLDER="/Apps/IncomingScans/_sorted"
NOTIFY_TO=""
